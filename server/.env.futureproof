# ------------------------------------------------------------
# LocalCat – Future‑Proof .env (15 simple knobs → full config)
# ------------------------------------------------------------
# Goal
# - Make day‑to‑day tuning trivial via 15 top‑level parameters
# - Keep full power: derive all current envs from those 15
# - Ready for runtime control (voice/UI) by updating these 15
#
# How to use now
# - The 15 parameters are at the top (authoritative for humans)
# - Below we include a Derived (legacy) section set to values that
#   match those 15 so you can run without any code changes today.
# - Later, the loader can compute the Derived section on startup.

#########################
# 15 Top‑Level Controls
#########################

# 1) PROFILE: latency/robustness preset (affects VAD/turn/tts)
#    ultra = fastest barge‑in, shortest stops (best for demos)
#    balanced = good tradeoff
#    stable = longer pauses, most tolerant to noise
PROFILE=ultra            # options: ultra | balanced | stable

# 2) INPUT_SENSITIVITY: mic/VAD sensitivity (maps to VAD min volume)
INPUT_SENSITIVITY=medium # options: low | medium | high

# 3) TURN_RESPONSIVENESS: end‑of‑utterance speed (maps to stop secs)
TURN_RESPONSIVENESS=fast # options: fast | normal | patient

# 4) STT_ENGINE: speech‑to‑text engine
STT_ENGINE=whisper_mlx_direct   # options: whisper_mlx_direct | parakeet_streaming | parakeet_isolated

# 5) STT_MODEL: model/id for STT
STT_MODEL=mlx-community/whisper-small.en-mlx-q4

# 6) STT_GUARD: anti‑hallucination strength
#    off = minimal filtering, normal = recommended, strict = strongest
STT_GUARD=normal         # options: off | normal | strict

# 7) LLM_BACKEND: language model backend
LLM_BACKEND=mlx          # options: mlx | http

# 8) LLM_MODEL: chat model name/id
LLM_MODEL=mlx-community/LFM2-1.2B-4bit   # small, fast SLM for voice

# 9) LLM_TEMPERATURE: style (lower = concise)
LLM_TEMPERATURE=0.7

# 15) TTS_ENGINE: text‑to‑speech engine
TTS_ENGINE=kokoro_professional  # options: kokoro_professional | kokoro_mlx | siri_streaming

# 11) TTS_LATENCY: streaming chunking profile
TTS_LATENCY=ultra        # options: ultra | balanced

# 12) TTS_VOICE: voice id
TTS_VOICE=af_heart

# 13) MEMORY_MODE: memory persistence and usage
#     off = disabled, ephemeral = enabled but non‑persistent, persistent = full persistence
MEMORY_MODE=ephemeral    # options: off | ephemeral | persistent

# 14) VISION_MODE: camera usage
#     off = no camera, input = send frames only, input+model = add vision model context
VISION_MODE=off          # options: off | input | input+model

# 15) SPEAKER_RECOGNITION: voice recognition mode
#     off = disabled, passive = recognize when present, enroll = guide enrollment flow
SPEAKER_RECOGNITION=enroll   # options: off | passive | enroll


################################################################
# Derived (legacy) section – concrete values matching the 15 knobs
# This block can be auto‑generated later. For now, it lets you run
# with today’s code without any changes. Adjust only if you need
# to override something very specific.
################################################################

##########
# CORE FEATURES from MEMORY_MODE, VISION_MODE, SPEAKER_RECOGNITION
##########
# For this prototype, we set concrete values matching the top knobs.
# MEMORY_MODE=ephemeral → enable memory, no persistence
VOICE_AGENT_MEMORY_ENABLED=true
VOICE_AGENT_SESSION_PERSISTENCE=false
MEMORY_BACKEND=hotpath

# VISION_MODE=off
VIDEO_INPUT_ENABLED=false
VISION_MODEL_ENABLED=false

# SPEAKER_RECOGNITION=passive
AUDIO_INTELLIGENCE_ENABLED=true
SPEAKER_AUTO_ENROLL_UTTERANCES=0
AUDIO_INTEL_REQUIRE_CONSENT=false
AUDIO_INTEL_INCLUDE_PRIVACY=false
AUDIO_INTEL_INTRO_PIPELINE=true

##########
# VAD + Smart Turn (derived from PROFILE, INPUT_SENSITIVITY, TURN_RESPONSIVENESS)
##########
# Base presets by PROFILE
#   ultra:   VAD_STOP=1.0   TURN_STOP=1.5   VAD_CONF=0.55   MIN_VOL=0.08
#   balanced:VAD_STOP=1.4   TURN_STOP=1.9   VAD_CONF=0.55   MIN_VOL=0.15
#   stable:  VAD_STOP=1.8   TURN_STOP=2.3   VAD_CONF=0.60   MIN_VOL=0.12

# INPUT_SENSITIVITY tweak (applied to MIN_VOL)
#   high:  −0.02  | medium: 0.00 | low: +0.02

# TURN_RESPONSIVENESS tweak (applied to stop secs)
#   fast: −0.2s | normal: 0.0s | patient: +0.3s

# Concrete values (PROFILE=ultra, INPUT_SENSITIVITY=medium, TURN_RESPONSIVENESS=fast)
VAD_CONFIDENCE=0.55
VAD_START_SECS=0.15
VAD_STOP_SECS=1.0
VAD_MIN_VOLUME=0.08

SMART_TURN_STOP_SECS=1.5
SMART_TURN_PRE_SPEECH_MS=275
SMART_TURN_MAX_DURATION_SECS=14.0

##########
# STT (Whisper MLX Direct defaults tuned for low hallucinations)
##########
VOICE_AGENT_STT_ENGINE=whisper_mlx_direct
VOICE_AGENT_STT_MODEL=mlx-community/whisper-small.en-mlx-q4
VOICE_AGENT_STT_LANGUAGE=en

# Whisper anti‑hallucination thresholds (STT_GUARD=normal)
WHISPER_NO_SPEECH_THRESHOLD=0.80
WHISPER_LOGPROB_THRESHOLD=-0.25
WHISPER_HALLUCINATION_SILENCE_THRESHOLD=0.50
WHISPER_VOLUME_THRESHOLD=0.015

# Whisper performance optimization (limits audio chunk duration)
WHISPER_MIN_SEGMENT_DURATION=0.3
WHISPER_MAX_AUDIO_DURATION=10.0

# Optional suppression list (comma‑separated, lowercase)
# WHISPER_SUPPRESS_PHRASES=im going to start the video,start recording

##########
# LLM (Direct MLX or HTTP)
##########
LLM_USE_DIRECT_MLX=true
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=not-needed
VOICE_AGENT_LLM_MODEL=mlx-community/LFM2-1.2B-4bit
VOICE_AGENT_LLM_MAX_TOKENS=1024
VOICE_AGENT_LLM_TEMPERATURE=0.7
LLM_USE_STREAMING=true

# Aggregation speeds up voice feel
LLM_AGGREGATION_TIMEOUT=0.15
LLM_TURN_EMULATED_VAD_TIMEOUT=0.40
LLM_ENABLE_EMULATED_VAD_INTERRUPTION=true

##########
# TTS (Kokoro streaming; latency profile controls chunk size)
##########
VOICE_AGENT_TTS_ENGINE=kokoro_professional
VOICE_AGENT_TTS_VOICE=af_heart
VOICE_AGENT_TTS_SPEED=1.0
VOICE_AGENT_TTS_SAMPLE_RATE=24000

TTS_ULTRA_LOW_LATENCY=false
TTS_CHUNK_SIZE_CHARS=120


##########
# Memory & session (kept minimal; loader can expand if MODE=personal)
##########
MEMORY_BACKEND=hotpath
VOICE_AGENT_SESSION_PERSISTENCE=$( [ "$MODE" = "personal" ] && echo true || echo false )


###############################################################
# Advanced overrides (uncomment to force a specific value)
###############################################################

# --- VAD (Silero) ---
# VAD_CONFIDENCE=0.60
# VAD_START_SECS=0.08
# VAD_STOP_SECS=1.2
# VAD_MIN_VOLUME=0.15

# --- Smart Turn ---
# SMART_TURN_STOP_SECS=1.9
# SMART_TURN_PRE_SPEECH_MS=300
# SMART_TURN_MAX_DURATION_SECS=16.0

# --- Whisper thresholds ---
# WHISPER_NO_SPEECH_THRESHOLD=0.85
# WHISPER_LOGPROB_THRESHOLD=-0.20
# WHISPER_HALLUCINATION_SILENCE_THRESHOLD=0.55
# WHISPER_VOLUME_THRESHOLD=0.020

# --- Memory/Mode ---
# MEMORY_MODE=off|ephemeral|persistent
# VOICE_AGENT_MEMORY_ENABLED=false
# VOICE_AGENT_SESSION_PERSISTENCE=true
ENABLE_EPHEMERAL_CHOICE=true

# --- Vision ---
# VISION_MODE=off|input|input+model
# VIDEO_INPUT_ENABLED=true
# VISION_MODEL_ENABLED=true

# --- Speaker recognition ---
# SPEAKER_RECOGNITION=off|passive|enroll
# AUDIO_INTELLIGENCE_ENABLED=false
# SPEAKER_AUTO_ENROLL_UTTERANCES=3

# --- TTS chunking ---
# TTS_LATENCY=balanced
# TTS_CHUNK_SIZE_CHARS=40
# Aggregator tuning (optional overrides)
FAST_TEXT_MIN_TOKENS=100
FAST_TEXT_MAX_TOKENS=200
FAST_TEXT_MAX_TIME=0.7