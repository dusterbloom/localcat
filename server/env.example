# Copy to server/.env and customize for your setup

#########################
# IDs & Models
#########################
USER_ID=your-user-id
AGENT_ID=locat

# OpenAI-compatible API (Ollama optimized)
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=gemma3:4b
EMBEDDING_MODEL=nomic-embed-text:latest

#########################
# Smart Turn / VAD
#########################
LOCAL_SMART_TURN_MODEL_PATH=pipecat-ai/smart-turn-v2

LLM_AGGREGATION_TIMEOUT=0.2
LLM_TURN_EMULATED_VAD_TIMEOUT=0.5
LLM_ENABLE_EMULATED_VAD_INTERRUPTION=true
VAD_STOP_SECS=0.8
SMART_TURN_STOP_SECS=1.5
KYUTAI_FINALIZE_DELAY_SEC=0.2

#########################
# STT Configuration
#########################
# Use Kyutai streaming STT (default) or Whisper MLX batch mode
USE_STREAMING_STT=true

# Kyutai STT Configuration (ultra-low latency streaming)
KYUTAI_STT_REPO=kyutai/stt-1b-en_fr-mlx
KYUTAI_ENABLE_VAD=false
KYUTAI_MAX_STEPS=4096

#########################
# TTS Configuration
#########################
# TTS Engine Selection: "native_kokoro", "piper", "mlx_kokoro"
# native_kokoro: 375ms TTFB (recommended for performance)
# piper: 150-200ms TTFB (fast but robotic)
# mlx_kokoro: 400-500ms TTFB (best quality)
TTS_ENGINE=native_kokoro

# Native Kokoro TTS Settings (375ms TTFB)
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0

# Piper TTS Settings (150-200ms TTFB)
USE_PIPER_TTS=false  # Legacy setting, use TTS_ENGINE instead
PIPER_VOICE=en_US-lessac-medium
PIPER_SPEED=1.0

#########################
# Ultra-Low Latency TTS (Kokoro)
#########################
# Enable ultra-low latency mode (40-80ms TTFB)
TTS_ULTRA_LOW_LATENCY=true

# Pre-warm models on startup for faster first response
PREWARM_MODELS=true

# Audio buffer size in milliseconds
KOKORO_BUFFER_MS=80

# Token chunk configuration (optional)
KOKORO_MIN_TOKENS=175
KOKORO_MAX_TOKENS=250

#########################
# HotMem Memory System
#########################
HOTMEM_BULLETS_MAX=3
HOTMEM_INTERIM_MIN_WORDS=6
HOTMEM_ENABLE_HANDSHAKE=true
MEMORY_SOURCES=graph,convo,summary
MEMORY_CONVO_INDEX=true
MEMORY_SUMMARY_ENABLED=true

# Storage paths (relative to server/)
HOTMEM_SQLITE=../data/memory.db
HOTMEM_LMDB_DIR=../data/graph.lmdb

# Logging
HOTMEM_LOG_FILE=server/.logs/hotmem.log
HOTMEM_CONSOLE_DEBUG=true
HOTMEM_LOG_LEVEL=DEBUG
HOTMEM_TRACE_FRAMES=false

# Injection formatting
HOTMEM_INJECT_ROLE=system
HOTMEM_INJECT_HEADER=Use the following factual context if helpful.

#########################
# Memory Retrieval Enhancement (Task 2)
#########################
# Prosody weight for conversation reranking (0.0-1.0)
# Set > 0.0 to enable prosody-weighted reranking for conversation candidates
MEMORY_WEIGHT_PROSODY=0.0

# Injection mode: "bullets" (legacy) or "headers" (compact)
# headers: Shows compact headers with confidence scalars, auto-expands weak items
# bullets: Traditional full bullet format (default for compatibility)
MEMORY_INJECTION_MODE=bullets

# Score threshold for header auto-expand (0.0-1.0)
# Candidates with combined score below this threshold expand to full text
# Only used when MEMORY_INJECTION_MODE=headers
MEMORY_HEADER_EXPAND_THRESHOLD=0.65

# Enable component logging for debugging (true/false)
# Shows scoring components for top 3 candidates when enabled
MEMORY_LOG_COMPONENTS=false

#########################
# Summarizer Prosody Bias
#########################
# Enable prosody bias in background summarization (true/false)
# When enabled, prioritizes high-certainty conversation turns for summarization
# Filters out very low certainty chatter (< 0.3 certainty)
SUMMARY_PROSODY_ENABLED=false

#########################
# Session Summary & LEANN
#########################
SESSION_SUMMARY_ENABLED=true
REBUILD_LEANN_ON_SESSION_END=true

# Semantic retrieval (requires pip install leann)
HOTMEM_USE_LEANN=true
LEANN_INDEX_PATH=../data/memory_vectors.leann
LEANN_BACKEND=hnsw
HOTMEM_LEANN_COMPLEXITY=16

#########################
# Extraction Quality
#########################
HOTMEM_DECOMPOSE_CLAUSES=false
HOTMEM_EXTRA_CONFIDENCE=false
HOTMEM_CONFIDENCE_THRESHOLD=0.3
HOTMEM_BYPASS_CONFIDENCE_FOR_BASIC=true
HOTMEM_CONFIDENCE_FLOOR_BASIC=0.6

#########################
# Periodic Summarizer (LLM)
#########################
SUMMARIZER_ENABLED=false
SUMMARIZER_BASE_URL=http://127.0.0.1:1234/v1
SUMMARIZER_API_KEY=
SUMMARIZER_MODEL=qwen3-4b-mlx
SUMMARIZER_INTERVAL_SECS=30
SUMMARIZER_MAX_TOKENS=160

# Windowing configuration
SUMMARIZER_WINDOW_MODE=delta
SUMMARIZER_TURN_PAIRS=2
SUMMARIZER_MAX_MESSAGES=16
SUMMARIZER_INCLUDE_USER=true
SUMMARIZER_INCLUDE_ASSISTANT=true

#########################
# Video & Vision Processing
#########################
# Enable video input from webcam (requires client support)
VIDEO_INPUT_ENABLED=true

# Frame rate for video capture (fps)
# Lower values reduce bandwidth and processing
VIDEO_TARGET_FPS=0.5

# Enable video output (not commonly used)
VIDEO_OUT_ENABLED=false

# Vision model integration (future feature)
VISION_MODEL_ENABLED=false

#########################
# Vision Optimization
#########################
# Image preprocessing for faster LLM vision processing
# Target size for image resizing (pixels, maintains aspect ratio)
# Reduces token count by ~75% (384x384 recommended for minicpm-v)
# Set to -1 to disable resizing
VISION_IMAGE_SIZE=384

# JPEG quality for image compression (1-100)
# Higher values = better quality but larger size
# 85 is a good balance between quality and performance
VISION_IMAGE_QUALITY=85

# Maximum images to keep in LLM context
# Prevents context bloat in long conversations
# Older images are pruned when limit exceeded
VISION_MAX_IMAGES_IN_CONTEXT=2

# Enable deduplication to skip injecting identical frames
# Reduces redundant LLM processing
VISION_ENABLE_DEDUPLICATION=true

# Keyword filtering for vision injection
# When enabled, only injects images when vision-related keywords detected
# Set to false to inject on every user message (not recommended)
VISION_KEYWORD_FILTER=true

# Custom vision keywords (comma-separated)
# Leave empty to use default keywords (see, look, show, describe, etc.)
# VISION_KEYWORDS=see,look,show,describe,video,image

# Optional external API keys (if not using local models)
OPENAI_API_KEY=""
DEEPGRAM_API_KEY=""
RIME_API_KEY=""