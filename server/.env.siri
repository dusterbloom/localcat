# Siri TTS Configuration for LocalCat
# Copy this to .env or set these environment variables to enable native macOS Siri voices

# Enable Siri Streaming TTS (uses native macOS voices - same as "Hey Siri")
VOICE_AGENT_TTS_ENGINE=siri_streaming

# Language selection (determines which Siri voice is used)
# Supported: en-US, en-GB, en-AU, en-IN, fr-FR, de-DE, es-ES, it-IT, ja-JP, zh-CN, etc.
SIRI_LANGUAGE=en-US

# Optional: Override automatic voice selection with specific voice ID
# Uncomment to use a specific voice:
# SIRI_VOICE_ID=com.apple.voice.enhanced.en-US.Ava

# Speech rate: 0.0 (very slow) to 1.0 (very fast)
# Default: 0.5 (natural conversational pace)
SIRI_RATE=0.5

# Pitch multiplier: 0.5 (lower) to 2.0 (higher)
# Default: 1.0 (natural pitch)
SIRI_PITCH=1.0

# Sample rate for TTS output (don't change unless you know what you're doing)
# 24000 is optimal for Siri, WebRTC will resample to 16000 automatically
VOICE_AGENT_TTS_SAMPLE_RATE=24000
