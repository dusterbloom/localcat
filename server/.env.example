# ------------------------------------------------------------
# LocalCat Server - Environment Example
# Copy to `server/.env` and adjust as needed.
# Safe defaults target <800ms voice-to-voice latency on Apple Silicon.
# ------------------------------------------------------------

# ------------------------------------------------------------
# Core Identity
# ------------------------------------------------------------
USER_ID=default-user
AGENT_ID=locat

# ------------------------------------------------------------
# LLM (OpenAI-compatible HTTP API)
# Run a local server (e.g., LM Studio) or Ollama with OpenAI API shim.
# ------------------------------------------------------------
VOICE_AGENT_LLM_BASE_URL=http://localhost:11434/v1
VOICE_AGENT_LLM_MODEL=gemma3n:e2b
VOICE_AGENT_LLM_API_KEY=not-needed
VOICE_AGENT_LLM_MAX_TOKENS=1024
VOICE_AGENT_LLM_TEMPERATURE=0.7
# Streaming generation reduces latency; keep enabled
LLM_USE_STREAMING=true

# Back-compat overrides (optional; prefer VOICE_AGENT_* above)
# LLM_BASE_URL=
# LLM_MODEL=

# ------------------------------------------------------------
# STT (Speech-To-Text)
# `parakeet_streaming` is optimized for low latency on MLX.
# Alternatives: parakeet_isolated, parakeet_batch, whisper_mlx, macos_native
# ------------------------------------------------------------
VOICE_AGENT_STT_ENGINE=parakeet_isolated
VOICE_AGENT_STT_MODEL=mlx-community/parakeet-tdt-0.6b-v3
VOICE_AGENT_STT_CHUNK_LENGTH_MS=100
VOICE_AGENT_STT_LANGUAGE=en

# Parakeet streaming configuration (optimal defaults based on NVIDIA recommendations)
VOICE_AGENT_STT_CHUNK_DURATION=2.0  # Audio buffering duration (2-4s optimal for reduced hallucinations, balanced for response time)
VOICE_AGENT_STT_CONTEXT_SIZE=256,256  # Attention context (128-256 tokens optimal)
VOICE_AGENT_STT_BEAM_WIDTH=8  # Beam search width (8-10 optimal for streaming hallucination reduction)
VOICE_AGENT_STT_DEPTH=3  # Model depth for streaming processing (1-5 reasonable range)
VOICE_AGENT_STT_TEMPERATURE=0.0  # Sampling temperature for transcription (0.0-1.0 recommended)
VOICE_AGENT_STT_SENTENCE_PAUSE_THRESHOLD=1.2  # Threshold for sentence boundary detection
VOICE_AGENT_STT_MAX_CHUNK_DURATION=4.0  # Maximum duration for audio chunks
VOICE_AGENT_STT_VOLUME_THRESHOLD=0.001  # Volume gating threshold
VOICE_AGENT_STT_ENABLE_VAD=false  # Enable internal VAD
VOICE_AGENT_STT_STREAMING=true  # Enable streaming mode for compatible engines

# Back-compat overrides (optional; prefer VOICE_AGENT_STT_* above)
# PARAKEET_CHUNK_DURATION=1.0
# PARAKEET_ENABLE_VAD=false
# PARAKEET_TEMPERATURE=0.0

# ------------------------------------------------------------
# TTS (Text-To-Speech)
# `supertonic` is the default - lightning-fast ONNX TTS (30-45x real-time).
# Alternatives: kokoro_mlx, kokoro_professional, siri_streaming
# ------------------------------------------------------------
VOICE_AGENT_TTS_ENGINE=supertonic
VOICE_AGENT_TTS_SPEED=1.0
VOICE_AGENT_TTS_SAMPLE_RATE=24000
VOICE_AGENT_TTS_FADE_DURATION_MS=50.0

# Supertonic settings (default TTS engine)
# Voice options: M1-M5 (male), F1-F5 (female)
SUPERTONIC_VOICE=F1
# Denoising steps: 2=fast (default), 5=higher quality
SUPERTONIC_TOTAL_STEPS=2
# Custom model path for bundled apps (optional)
# SUPERTONIC_MODEL_PATH=/path/to/bundled/supertonic

# Kokoro TTS settings (alternative engine)
# VOICE_AGENT_TTS_ENGINE=kokoro_mlx
# VOICE_AGENT_TTS_VOICE=af_heart
# TTS_MODEL=mlx-community/Kokoro-82M-bf16

# Qwen3 TTS settings (emotional control + voice cloning)
# VOICE_AGENT_TTS_ENGINE=qwen3
# VOICE_AGENT_TTS_VOICE=Ryan          # Ryan, Aiden (EN), Vivian, Serena (CN), etc.
# QWEN3_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# QWEN3_MODEL_TYPE=custom_voice       # custom_voice, base (clone), voice_design
# QWEN3_LANGUAGE=English
# QWEN3_INSTRUCT=Warm and friendly    # Emotional instruction (optional)
# QWEN3_REF_AUDIO=/path/to/ref.wav    # Voice cloning reference (base model only)
# QWEN3_REF_TEXT=Transcript here       # Reference audio transcript

# Siri TTS settings (macOS fallback)
# VOICE_AGENT_TTS_ENGINE=siri_streaming

# Optional TTS worker tuning
# TTS_MIN_TOKENS=150
# TTS_MAX_TOKENS=200
# TTS_ABSOLUTE_MAX_TOKENS=350
# TTS_BUFFER_MS=40
# TTS_PREWARM=true

# ------------------------------------------------------------
# VAD / Turn Detection (conservative defaults for fluid speech)
# ------------------------------------------------------------
VAD_CONFIDENCE=0.5
VAD_START_SECS=0.1
VAD_STOP_SECS=4.0
VAD_MIN_VOLUME=0.4
SMART_TURN_STOP_SECS=4.0
SMART_TURN_PRE_SPEECH_MS=300
SMART_TURN_MAX_DURATION_SECS=16.0

# ------------------------------------------------------------
# Memory System (HotPath processor by default - RECOMMENDED)
#
# HotPath is the unified memory solution with:
# - ✅ Automatic context injection with emoji formatting
# - ✅ Explicit tool access (remember, recall, forget, search)
# - ✅ DirectMLX performance (5-6x faster than HTTP)
# - ✅ Superior retrieval accuracy and relevance
#
# LEGACY: HotMem is deprecated. Set MEMORY_BACKEND=hotmem only for
# backward compatibility during migration. HotMem will be removed
# in a future release.
# ------------------------------------------------------------
MEMORY_BACKEND=hotpath
VOICE_AGENT_MEMORY_ENABLED=true
VOICE_AGENT_HOTPATH_ENABLED=true
VOICE_AGENT_SESSION_PERSISTENCE=true

# Storage (optional; if unset, in-memory defaults are used where supported)
# MEMORY_SQLITE_PATH=./data/memory.db
# MEMORY_LMDB_PATH=./data/graph.lmdb

# Behavior & caps
MEMORY_BULLETS_MAX=3
MEMORY_INTERIM_MIN_WORDS=6
MEMORY_INJECT_ROLE=user
MEMORY_INJECT_HEADER=[Memory context]
MEMORY_SOURCES=graph,convo,summary
MEMORY_CONVO_INDEX=false
MEMORY_ENABLE_HANDSHAKE=true
INTENT_CLASSIFICATION_ENABLED=true

# Sliding window for long conversations
CONTEXT_SLIDING_WINDOW=true
CONTEXT_MAX_TURN_PAIRS=4

# Token-aware context management (prevents degradation in long chats)
# Maximum tokens for LLM context (reserve ~1000 tokens for response)
LLM_CONTEXT_MAX_TOKENS=3000
# Prune at this threshold (0.70 = prune at 70% capacity)
LLM_CONTEXT_PRUNE_THRESHOLD=0.70
# Always keep at least this many recent turns for coherence
LLM_CONTEXT_MIN_TURNS=3

# Context Compactor (replaces old summarizer — uses dedicated small MLX model)
ENABLE_CONTEXT_COMPACTOR=true
COMPACTOR_MODEL=mlx-community/Qwen3-0.6B-4bit
CONTEXT_COMPACT_THRESHOLD=0.75
CONTEXT_COMPACT_COOLDOWN_MESSAGES=5
CONTEXT_COMPACT_TIMEOUT=30
RECENCY_HALF_LIFE_HOURS=24

# Coreference / NLP / Processor settings
MEMORY_COREFERENCE_ENABLED=false
MEMORY_COREFERENCE_TIMEOUT_MS=50
MEMORY_COREFERENCE_MIN_LENGTH=10
MEMORY_COREFERENCE_MODEL=en_core_web_sm
MEMORY_COREFERENCE_FALLBACK=true
MEMORY_COREFERENCE_LANG=en

NLP_CACHE_ENABLED=true
NLP_DEFAULT_LANG=en
NLP_MODEL_TIMEOUT_MS=30000
NLP_MAX_CACHED_MODELS=5

MEMORY_PROCESSORS_ENABLED=true
MEMORY_MAX_PROCESSORS=10
MEMORY_PROCESSOR_TIMEOUT_MS=200
MEMORY_PROCESSOR_METRICS=true
MEMORY_PROCESSOR_METRICS_MAX=1000

# Optional exclusions / guidance
# EXCLUDED_MEMORY_PHRASES=
# MEMORY_CONTEXT_GUIDE=

# ------------------------------------------------------------
# Audio Intelligence (Speaker recognition, enrollment UX)
# Set INTRO_PIPELINE=true for first-time enrollment with guided messages.
# ------------------------------------------------------------
AUDIO_INTELLIGENCE_ENABLED=true
AUDIO_INTEL_INTRO_PIPELINE=true
AUDIO_INTEL_SKIP_FOR_RETURNING=true
AUDIO_INTEL_FORCE_INTRO=false
AUDIO_INTEL_INCLUDE_PRIVACY=false

# Device & thresholds
AUDIO_INTEL_USE_MPS=true
SPEAKER_PROFILE_DIR=./data/speaker_profiles
SPEAKER_SIMILARITY_THRESHOLD=0.75
SPEAKER_MIN_UTTERANCE_SEC=1.0
SPEAKER_AUTO_ENROLL_UTTERANCES=3
SPEAKER_CONSISTENCY_THRESHOLD=0.80
AUDIO_INTEL_ENABLE_EMOTION=true
AUDIO_INTEL_ENABLE_PROSODY=true
AUDIO_INTEL_PRIVACY_MODE=auto_enroll
AUDIO_INTEL_REQUIRE_CONSENT=false
AUDIO_INTEL_CONSENT_TIMEOUT_SEC=300

# Enrollment flow text (customizable)
# AUDIO_INTEL_INTRO_MESSAGE=Hi! I'm LocalCat... (custom message)
# AUDIO_INTEL_PROGRESS_TEMPLATE=Learning your voice... {current} of {total}
# AUDIO_INTEL_COMPLETION_TEMPLATE=Perfect! I'll remember you{name}. How can I help you today?
# AUDIO_INTEL_WELCOME_BACK_TEMPLATE=Welcome back{name}! What can I help you with?
# AUDIO_INTEL_PRIVACY_EXPLANATION=I store your voice profile locally on your device...

# Enrollment phrase (optional)
ENROLLMENT_FIXED_PHRASE=LocalCat learns my voice.
ENROLLMENT_REQUIRE_FIXED_PHRASE=false
VOICE_AGENT_RETURNING_GREETING=welcome_back

# Optional mic probe for input diagnostics
ENABLE_MIC_PROBE=false
MIC_PROBE_LOG_EVERY=20
MIC_PROBE_WARMUP_LOGS=10

# ------------------------------------------------------------
# Observability / Debug
# ------------------------------------------------------------
VOICE_AGENT_DEBUG_MODE=false
VOICE_AGENT_LOG_LEVEL=INFO
HOTMEM_LOG_LEVEL=DEBUG
MEMORY_TRACE_FRAMES=false

# Persisted session stats (JSON). Set a custom path if desired.
SESSION_STATS_PATH=./data/session_stats.json
# Optional database-based session tracker
# SESSION_DB_PATH=

# Speed up HF model startup after first run
# HF_HUB_OFFLINE=1

# Avoid tokenizer parallelism warnings in forked processes
TOKENIZERS_PARALLELISM=false

# ------------------------------------------------------------
# Memory Verifier (Query-conditioned filter)
# ------------------------------------------------------------
# Memory Verifier (Query-conditioned filter)
#
# Use a pairwise verifier to drop contradicting memories and boost entailed ones.
# Backends:
#   - auto (default): detect from model name
#   - hf: generic HF sequence classification/reranker
#   - jina: Jina official reranker pipeline (pair tokenizer + score head)
#
# Recommended Jina tiny model keeps latency small while restoring accuracy:
# MEMORY_VERIFIER_ENABLED=true
# MEMORY_VERIFIER_BACKEND=jina
# MEMORY_VERIFIER_MODEL=jinaai/jina-reranker-v3-tiny
# MEMORY_VERIFIER_ENT_T=0.6
# MEMORY_VERIFIER_CON_T=0.6
# MEMORY_VERIFIER_MAXLEN=384
# MEMORY_VERIFIER_BOOST=0.5
# MEMORY_VERIFIER_ALLOW_UNKNOWN=1

# ------------------------------------------------------------
# Jina Reranker (pairwise entailment used in scoring)
#
# Enable to add Jina reranker probability directly into composite scoring
# before bullet selection. This often improves top-1 and selection under
# tight budgets.
#
# MEMORY_RERANK_JINA_ENABLED=false
# MEMORY_RERANK_JINA_MODEL=jinaai/jina-reranker-v3-large
# MEMORY_RERANK_JINA_MAXLEN=512
# MEMORY_RERANK_JINA_MAX_CANDIDATES=24
# MEMORY_RERANK_JINA_WEIGHT=0.25
