# ------------------------------------------------------------
# LocalCat Memory System - Enhanced Configuration
#
# This configuration enables all semantic features for improved
# memory retrieval accuracy. Use this for LoCoMo benchmark testing.
#
# Usage:
#   1. Copy to .env or source alongside existing .env
#   2. Run: python tools/run_locomo_benchmark.py --full
#
# Expected improvement: 3.68% (FTS baseline) → 25-35% F1
# Target: SimpleMem's 43.24% F1
# ------------------------------------------------------------

# =============================================================
# SEMANTIC RETRIEVAL (FAISS vector index)
# =============================================================
# Enable semantic sidecar for embedding-based retrieval
# Uses all-MiniLM-L6-v2 by default
MEMORY_SEMANTIC_ENABLED=true
MEMORY_SEMANTIC_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORY_SEMANTIC_DUP_THRESHOLD=0.85

# =============================================================
# COREFERENCE RESOLUTION (Pronoun resolution)
# =============================================================
# Resolves "he", "she", "they" before storage
# Uses spacy-coref model
MEMORY_COREFERENCE_ENABLED=true
MEMORY_COREFERENCE_TIMEOUT_MS=100
MEMORY_COREFERENCE_MIN_LENGTH=10
MEMORY_COREFERENCE_MODEL=en_core_web_sm
MEMORY_COREFERENCE_FALLBACK=true
MEMORY_COREFERENCE_LANG=en

# =============================================================
# EXTRACTION ENHANCEMENT (BERT-NER + MiniLM)
# =============================================================
# BERT-NER: Named entity recognition enhancement
# MiniLM: Semantic noise filtering and entity linking
USE_BERT_NER=true
USE_MINILM=true
EXTRACT_BUDGET_MS=80
EXTRACT_VERIFY_ENABLED=true

# =============================================================
# DSPY LLM EXTRACTION (Complex sentence handling)
# =============================================================
# Uses LLM to extract missing edges from complex sentences
# Requires OpenAI API key or local LLM server
ENABLE_DSPY_EXTRACTION=true
# DSPY_BASE_URL=http://localhost:11434/v1  # For local Ollama
# DSPY_MODEL=llama3.2  # Model for extraction

# =============================================================
# DEDUPLICATION (Jaccard similarity)
# =============================================================
# Prevents duplicate memories from being stored/retrieved
MEMORY_DEDUP_THRESHOLD=0.6

# =============================================================
# BACKGROUND SUMMARIZATION (Optional)
# =============================================================
# Periodically summarizes conversation turns
# Requires LLM endpoint
MEMORY_SUMMARIZATION_ENABLED=false
# MEMORY_SUMMARY_TURN_PAIRS=5
# MEMORY_SUMMARY_INTERVAL_SECS=30

# =============================================================
# VERIFIER (Query-conditioned filtering)
# =============================================================
# Filters contradicting memories, boosts entailed ones
# Already provides +10% precision in micro-eval
MEMORY_VERIFIER_ENABLED=true
MEMORY_VERIFIER_BACKEND=jina
MEMORY_VERIFIER_MODEL=jinaai/jina-reranker-v3-tiny
MEMORY_VERIFIER_ENT_T=0.6
MEMORY_VERIFIER_CON_T=0.6

# =============================================================
# RETRIEVAL SOURCES
# =============================================================
# Use all available sources: graph triples, conversation FTS, summaries
MEMORY_SOURCES=graph,convo,summary

# =============================================================
# NLP PROCESSING
# =============================================================
MEMORY_PROCESSORS_ENABLED=true
NLP_CACHE_ENABLED=true
NLP_DEFAULT_LANG=en

# =============================================================
# DEBUG (enable for benchmark analysis)
# =============================================================
HOTMEM_LOG_LEVEL=DEBUG
MEMORY_TRACE_FRAMES=false
