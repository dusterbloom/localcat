# Enhanced .env for extraction testing with bot.py
# Copy to server/.env to enable full extraction pipeline testing

#########################
# IDs & Models
#########################
USER_ID=test_user
AGENT_ID=locat

# OpenAI-compatible API (Ollama optimized)
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text:latest

#########################
# HotMem Storage & Logs
#########################
HOTMEM_SQLITE=../data/memory_test.db
HOTMEM_LMDB_DIR=../data/graph_test.lmdb
HOTMEM_LOG_FILE=../logs/hotmem_test.log
HOTMEM_CONSOLE_DEBUG=true
HOTMEM_LOG_LEVEL=DEBUG
HOTMEM_TRACE_FRAMES=true

#########################
# EXTRACTION STRATEGY CONFIGURATION
#########################
# Available strategies: enhanced_level3, asi1, asi2, enhanced_hotmem, lightweight, tiered
DEFAULT_EXTRACTION_STRATEGY=enhanced_level3
FALLBACK_EXTRACTION_STRATEGY=

# Registry routing (uses strategy system)
HOTMEM_ROUTE_TO_REGISTRY=true

#########################
# EXTRACTION FEATURES
#########################
# GLiNER for entity extraction (96.7% accuracy)
HOTMEM_USE_GLINER=flase

# GLiREL for relation extraction (replaces ReLiK)
HOTMEM_USE_GLIREL=flase

# Semantic Role Labeling
HOTMEM_USE_SRL=false

# Coreference resolution
HOTMEM_USE_COREF=true
HOTMEM_COREF_DEVICE=cpu
HOTMEM_COREF_MAX_ENTITIES=24

# Temporal extraction optimization
HOTMEM_USE_TEMPORAL_EXTRACTION=true
TEMPORAL_OPTIMIZED_PIPELINE=true
TEMPORAL_MODEL=en_core_web_sm

# Semantic filtering (quality control)
HOTMEM_USE_SEMANTIC_FILTER=true

#########################
# LLM-ASSISTED EXTRACTION
#########################
# Enable LLM fallback for complex sentences
HOTMEM_LLM_ASSISTED=true
HOTMEM_LLM_ASSISTED_MODEL=qwen2.5:3b
HOTMEM_LLM_ASSISTED_BASE_URL=http://127.0.0.1:11434/v1
HOTMEM_LLM_ASSISTED_TIMEOUT_MS=2000
HOTMEM_LLM_ASSISTED_MAX_TRIPLES=5
HOTMEM_LLM_ASSISTED_JSON_MODE=true
HOTMEM_LLM_ASSISTED_LOG_REQUEST=false
HOTMEM_LLM_ASSISTED_LOG_RAW=false

# Complexity threshold for LLM fallback
HOTMEM_COMPLEXITY_THRESHOLD=0.6

#########################
# EXTRACTION QUALITY GATES
#########################
# Minimum confidence to store edges (higher = fewer edges = faster)
HOTMEM_MIN_EDGE_CONFIDENCE=0.8
HOTMEM_CONFIDENCE_THRESHOLD=0.5
HOTMEM_BYPASS_CONFIDENCE_FOR_BASIC=true
HOTMEM_CONFIDENCE_FLOOR_BASIC=0.7
HOTMEM_EXTRA_CONFIDENCE=false

# Clause decomposition for complex sentences
HOTMEM_DECOMPOSE_CLAUSES=true

# Pronoun detection mode
HOTMEM_PRONOUN_DETECT=string

#########################
# RETRIEVAL CONFIGURATION
#########################
# Fusion retrieval (KG + FTS + Semantic)
HOTMEM_RETRIEVAL_FUSION=true
HOTMEM_GRAPH_ENABLED=true
HOTMEM_FTS_ONLY_SUMMARY=true
HOTMEM_FTS_MIN_OVERLAP=0.1
HOTMEM_PIN_INTENT_MATCH=true
HOTMEM_STORE_TOPK=8

# Retrieval debugging
HOTMEM_RETRIEVAL_DEBUG=true

#########################
# SEMANTIC SEARCH (LEANN)
#########################
HOTMEM_USE_LEANN=true
LEANN_INDEX_PATH=../data/memory_vectors_test.leann
LEANN_BACKEND=hnsw
HOTMEM_LEANN_COMPLEXITY=16
REBUILD_LEANN_ON_SESSION_END=true
HOTMEM_USE_LEANN_SUMMARIES=true

#########################
# CONTEXT INJECTION
#########################
HOTMEM_INJECT_ROLE=system
HOTMEM_INJECT_HEADER=Use the following factual context if helpful.
HOTMEM_BULLETS_MAX=3

#########################
# SESSION MANAGEMENT
#########################
SESSION_SUMMARY_ENABLED=true
HOTMEM_MAX_RECENCY=100

#########################
# TIERED EXTRACTION (if using tiered strategy)
#########################
# Tier thresholds and models configured in tiered_extractor.py

#########################
# ONNX MODELS (Optional, for advanced local extraction)
#########################
HOTMEM_USE_ONNX_NER=false
HOTMEM_ONNX_NER_MODEL=
HOTMEM_ONNX_NER_LABELS=
HOTMEM_ONNX_NER_TOKENIZER=bert-base-cased

HOTMEM_USE_ONNX_SRL=false
HOTMEM_ONNX_SRL_MODEL=
HOTMEM_ONNX_SRL_LABELS=
HOTMEM_ONNX_SRL_TOKENIZER=bert-base-cased

#########################
# LEGACY RELIK (Deprecated, use GLiREL instead)
#########################
HOTMEM_USE_RELIK=false

#########################
# DSPy (Experimental self-improving extraction)
#########################
HOTMEM_USE_DSPY=false

#########################
# MONITORING
#########################
MONITORING_ENABLED=true

#########################
# WHISPER & TTS
#########################
WHISPER_STT_MODEL=MEDIUM
VAD_STOP_SECS=0.2
TTS_MODEL=mlx-community/Kokoro-82M-bf16
TTS_VOICE=af_heart
TTS_SAMPLE_RATE=24000

#########################
# SUMMARIZER
#########################
SUMMARIZER_ENABLED=true
SUMMARIZER_BASE_URL=http://127.0.0.1:11434/v1
SUMMARIZER_API_KEY=
SUMMARIZER_MODEL=qwen2.5:3b
SUMMARIZER_INTERVAL_SECS=30
SUMMARIZER_MAX_TOKENS=160
SUMMARIZER_WINDOW_MODE=delta
SUMMARIZER_TURN_PAIRS=2
SUMMARIZER_MAX_MESSAGES=16
SUMMARIZER_INCLUDE_USER=true
SUMMARIZER_INCLUDE_ASSISTANT=true

#########################
# PROMPT VARIANT
#########################
# base | free
PROMPT_VARIANT=base

#########################
# PERFORMANCE OPTIMIZATIONS
#########################
# CRITICAL: Disable SOTA classifier (saves 1655ms per turn)
HOTMEM_USE_SOTA_CLASSIFIER=false

# Memory extraction optimizations
HOTMEM_EXTRACTION_TIMEOUT=200
HOTMEM_USE_SIMPLE_EXTRACTION=false

# Retrieval performance optimizations
HOTMEM_RETRIEVAL_TIMEOUT=50

# Performance monitoring
HOTMEM_ENABLE_METRICS=true
HOTMEM_LOG_PERFORMANCE=true

# Target latency budgets (ms)
HOTMEM_TARGET_TOTAL_MS=200
HOTMEM_TARGET_EXTRACTION_MS=100
HOTMEM_TARGET_RETRIEVAL_MS=50
HOTMEM_TARGET_INTENT_MS=20

#########################
# TESTING FLAGS
#########################
# Enable verbose extraction logging
HOTMEM_VERBOSE_EXTRACTION=true

# Test mode: creates separate test databases
TEST_MODE=true
