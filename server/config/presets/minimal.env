# Minimal Voice Agent Configuration
# For basic testing and development

# Core Components (minimal setup)
VOICE_AGENT_STT_ENGINE=kyutai
VOICE_AGENT_TTS_ENGINE=kokoro_professional
VOICE_AGENT_TTS_VOICE=af_heart

# LLM Configuration
VOICE_AGENT_LLM_BASE_URL=http://localhost:1234/v1
VOICE_AGENT_LLM_MODEL=gemma3n-4b

# Performance (relaxed targets for testing)
VOICE_AGENT_TARGET_LATENCY_MS=1000

# Memory (disabled for minimal setup)
VOICE_AGENT_MEMORY_ENABLED=false
VOICE_AGENT_HOTPATH_ENABLED=false
VOICE_AGENT_SESSION_PERSISTENCE=false

# Debug
VOICE_AGENT_DEBUG_MODE=true
VOICE_AGENT_LOG_LEVEL=DEBUG