# Advanced Voice Agent Configuration
# Full features with backup implementations

# Primary Stack (optimized for <800ms latency)
VOICE_AGENT_STT_ENGINE=kyutai
VOICE_AGENT_TTS_ENGINE=kokoro_professional

# Backup Stack (fallback implementations)
# To use backups, change engines to:
# VOICE_AGENT_STT_ENGINE=whisper_mlx
# VOICE_AGENT_TTS_ENGINE=kokoro_mlx

# TTS Advanced Settings
VOICE_AGENT_TTS_VOICE=af_heart
VOICE_AGENT_TTS_SPEED=1.0
VOICE_AGENT_TTS_SAMPLE_RATE=24000
VOICE_AGENT_TTS_FADE_DURATION_MS=50.0
VOICE_AGENT_TTS_TARGET_PEAK_DB=-3.0

# STT Advanced Settings
VOICE_AGENT_STT_CHUNK_LENGTH_MS=100
VOICE_AGENT_STT_LANGUAGE=en

# LLM Advanced Settings
VOICE_AGENT_LLM_BASE_URL=http://localhost:1234/v1
VOICE_AGENT_LLM_MODEL=gemma3n-4b
VOICE_AGENT_LLM_MAX_TOKENS=1024
VOICE_AGENT_LLM_TEMPERATURE=0.7

# Performance Optimization (ultra-low latency)
VOICE_AGENT_TARGET_LATENCY_MS=737  # Research finding: 737ms achievable
VOICE_AGENT_TTS_CHUNK_SIZE_CHARS=25  # Optimal chunk size
VOICE_AGENT_ENABLE_STREAMING_TTS=true

# Memory System (full features)
VOICE_AGENT_MEMORY_ENABLED=true
VOICE_AGENT_HOTPATH_ENABLED=true
VOICE_AGENT_SESSION_PERSISTENCE=true
VOICE_AGENT_MEMORY_MAX_ENTRIES=1000
VOICE_AGENT_MEMORY_CLEANUP_INTERVAL_MINUTES=60

# Audio Pipeline
VOICE_AGENT_PIPELINE_AUDIO_SAMPLE_RATE=24000
VOICE_AGENT_PIPELINE_AUDIO_CHANNELS=1
VOICE_AGENT_PIPELINE_FRAME_SIZE_MS=20

# VAD Settings
VOICE_AGENT_VAD_THRESHOLD=0.5
VOICE_AGENT_VAD_CHUNK_MS=100

# Quality & Monitoring
VOICE_AGENT_TTS_ENABLE_QUALITY_LOGGING=true
VOICE_AGENT_ENABLE_AUDIO_QUALITY_VALIDATION=true
VOICE_AGENT_ENABLE_PERFORMANCE_LOGGING=true

# Debug & Development
VOICE_AGENT_DEBUG_MODE=false
VOICE_AGENT_LOG_LEVEL=INFO

# Paths
VOICE_AGENT_MODELS_CACHE_DIR=${HOME}/.cache/voice-agent
VOICE_AGENT_SESSION_DATA_DIR=${HOME}/.local/share/voice-agent