# Default Voice Agent Configuration
# Optimized based on research findings for <800ms latency

# Core Components (optimized defaults)
VOICE_AGENT_STT_ENGINE=kyutai
VOICE_AGENT_TTS_ENGINE=kokoro_professional
VOICE_AGENT_TTS_VOICE=af_heart
VOICE_AGENT_TTS_SPEED=1.0

# LLM Configuration (Ollama llama3.2:1b for 303ms TTFT)
VOICE_AGENT_LLM_BASE_URL=http://localhost:1234/v1
VOICE_AGENT_LLM_MODEL=gemma3n-4b
VOICE_AGENT_LLM_TEMPERATURE=0.7

# Performance Targets (based on optimization findings)
VOICE_AGENT_TARGET_LATENCY_MS=800
VOICE_AGENT_TTS_CHUNK_SIZE_CHARS=25  # Optimal for 487ms TTFB

# Memory System (full features)
VOICE_AGENT_MEMORY_ENABLED=true
VOICE_AGENT_HOTPATH_ENABLED=true
VOICE_AGENT_SESSION_PERSISTENCE=true

# Audio Quality
VOICE_AGENT_TTS_FADE_DURATION_MS=50.0
VOICE_AGENT_TTS_TARGET_PEAK_DB=-3.0
VOICE_AGENT_TTS_ENABLE_QUALITY_LOGGING=true

# Debug
VOICE_AGENT_DEBUG_MODE=false
VOICE_AGENT_LOG_LEVEL=INFO
VOICE_AGENT_ENABLE_PERFORMANCE_LOGGING=true