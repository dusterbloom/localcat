# CRITICAL FIX 1: Switch to fast lightweight model
LLM_MODEL=llama-3.2-1b-instruct

# CRITICAL FIX 2: Disable vision processing (major overhead)
VISION_MODEL_ENABLED=false

# CRITICAL FIX 3: Ensure streaming is enabled
LLM_USE_STREAMING=true

# CRITICAL FIX 4: Disable debug logging overhead
DEBUG_MODE=false
LOG_LEVEL=WARNING

# CRITICAL FIX 5: Optimize LLM context for speed
LLM_CONTEXT_MAX_TOKENS=800  # Reduced from 1500
LLM_CONTEXT_PRUNE_THRESHOLD=0.50  # More aggressive pruning
LLM_CONTEXT_MIN_TURNS=2  # Minimal context

# CRITICAL FIX 6: Disable SOTA classifier (pipeline killer)
HOTMEM_USE_SOTA_CLASSIFIER=false

# CRITICAL FIX 7: Optimize memory system
MEMORY_ENABLED=false  # Disable for testing anonymous mode
ENHANCED_LEVEL3_COMPLEXITY=low
HOTMEM_EXTRACTION_TIMEOUT=200
HOTMEM_USE_SIMPLE_EXTRACTION=true

# CRITICAL FIX 8: Optimize LLM timeouts
LLM_AGGREGATION_TIMEOUT=0.10  # Faster aggregation
LLM_TURN_EMULATED_VAD_TIMEOUT=0.05  # Quick barge-in

# PERFORMANCE MONITORING
ENABLE_PERFORMANCE_LOGGING=true
TARGET_LATENCY_MS=500  # New realistic target