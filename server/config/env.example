OPENAI_API_KEY=""
DEEPGRAM_API_KEY=""
RIME_API_KEY=""

# ------- Extraction Strategy Selection -------
# Set default/fallback extractor strategies (see components.extraction.extraction_strategies)
# Options include: enhanced_level3, asi1, asi2, enhanced_hotmem, ud, lightweight, hybrid, multilingual, pattern
# Go all-in on Enhanced Level3 quality extractor; leave fallback empty to disable.
DEFAULT_EXTRACTION_STRATEGY=enhanced_level3
FALLBACK_EXTRACTION_STRATEGY=

# Enhanced Level3 configuration (optional tuning)
# ENHANCED_LEVEL3_SPACY_MODEL=en_core_web_sm        # default; alias 'en_core_web_rtf' -> 'en_core_web_trf'
# ENHANCED_LEVEL3_ENTITY_CONF=0.70                  # min entity confidence to include
# ENHANCED_LEVEL3_RELATION_CONF=0.65                # min relation confidence to emit
# ENHANCED_LEVEL3_TARGET_ENT=50                     # cap entities
# ENHANCED_LEVEL3_TARGET_REL=30                     # cap relations
# ENHANCED_LEVEL3_EXTRA_VERBS=                      # comma-separated extras (e.g., argue,weigh,consider)

# Transformer Quality Preset (uncomment to use)
# ENHANCED_LEVEL3_SPACY_MODEL=en_core_web_rtf       # uses en_core_web_trf under the hood
# ENHANCED_LEVEL3_ENTITY_CONF=0.65
# ENHANCED_LEVEL3_RELATION_CONF=0.55
# ENHANCED_LEVEL3_TARGET_REL=40
# ENHANCED_LEVEL3_EXTRA_VERBS=argue,weigh,consider,foster,prove,seek,reveal,mitigate,preserve

# ------- HotMem Retrieval & Semantics -------
# Use LEANN semantic search for KG triples (optional)
HOTMEM_USE_LEANN=false
# Complexity (trade-off quality/latency) for LEANN search
HOTMEM_LEANN_COMPLEXITY=16
# Enable fusion of KG + FTS + (optional) LEANN summaries in retrieval
HOTMEM_RETRIEVAL_FUSION=false
# Use LEANN to semantically search summaries (requires index with summaries)
HOTMEM_USE_LEANN_SUMMARIES=false

# ------- SRL (Semantic Roles) -------
# Prefer SRL-first extraction and fuse with UD patterns
HOTMEM_USE_SRL=false
# Optional multilingual embedding model for relation normalization
HOTMEM_REL_EMBED_MODEL=

# ------- ONNX NER / SRL (Advanced, fully local) -------
# Enrich entity mapping via token-classifier NER (BIO labels)
HOTMEM_USE_ONNX_NER=false
HOTMEM_ONNX_NER_MODEL=
HOTMEM_ONNX_NER_LABELS=
HOTMEM_ONNX_NER_TOKENIZER=bert-base-cased

# Extract roles via SRL tagger (BIO SRL tags, e.g., B-V, B-ARG0)
HOTMEM_USE_ONNX_SRL=false
HOTMEM_ONNX_SRL_MODEL=
HOTMEM_ONNX_SRL_LABELS=
HOTMEM_ONNX_SRL_TOKENIZER=bert-base-cased

# ------- Coreference (Neural) -------
HOTMEM_USE_COREF=false
HOTMEM_COREF_DEVICE=cpu
HOTMEM_COREF_MODE=lite

# ------- ReLiK (Relation Extraction) -------
HOTMEM_USE_RELIK=false
HOTMEM_RELIK_MODEL_ID=relik-ie/relik-relation-extraction-small
HOTMEM_RELIK_DEVICE=cpu

# Storage paths (relative to server/ by default)
HOTMEM_SQLITE=memory.db
HOTMEM_LMDB_DIR=graph.lmdb

# ------- Summarizer (LLM) -------
SUMMARIZER_ENABLED=true
SUMMARIZER_BASE_URL=http://127.0.0.1:11434/v1
SUMMARIZER_MODEL=qwen3:4b
SUMMARIZER_MAX_TOKENS=160
SUMMARIZER_LOG_SUMMARIES=false
SUMMARIZER_INTERVAL_SECS=30

# ------- Logging -------
HOTMEM_LOG_LEVEL=INFO
HOTMEM_CONSOLE_DEBUG=true

# ------- Temporal Extraction -------
# Enable temporal context extraction and optimized spaCy matcher
TEMPORAL_EXTRACTION_ENABLED=false
TEMPORAL_OPTIMIZED_PIPELINE=true
TEMPORAL_MODEL=en_core_web_sm

# ------- KG Storage Quality -------
# Minimum confidence required to persist edges into the KG
# Recommended: 0.75–0.80 for high-signal graphs
HOTMEM_MIN_EDGE_CONFIDENCE=0.8

# ------- Prompt + Context -------
# base|free (free can be overridden by LIBERATION_TOP_SYSTEM_PROMPT)
PROMPT_VARIANT=base
# Hard cap for packed context (system + memory + summaries + dialogue)
CONTEXT_BUDGET_TOKENS=4096
# Include latest summary snippet in context (set false to disable while tuning)
CONTEXT_INCLUDE_SUMMARY=true

# Optional: point to a file for custom free-variant system prompt (avoids .env parsing issues)
# LIBERATION_TOP_SYSTEM_PROMPT_FILE=/abs/path/to/prompt.txt
# Or use inline (avoid triple quotes in .env):
# LIBERATION_TOP_SYSTEM_PROMPT=You are Locat, a thoughtful assistant...
