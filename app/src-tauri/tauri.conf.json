{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "com.localcat",
  "productName": "LocalCat",
  "version": "1.0.0",
  "build": {
    "frontendDist": "../../client/out"
  },
  "app": {
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "LocalCat",
        "width": 1024,
        "height": 768,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "targets": ["app"],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/128x128.png"],
    "resources": [
      "sidecar/siri-tts/siri-tts"
    ]
  }
}
