{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "io.localcat.app",
  "productName": "LocalCat",
  "version": "1.0.0",
  "build": {
    "beforeBuildCommand": "npm --prefix ../client run build",
    "frontendDist": "../../client/out"
  },
  "app": {
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "LocalCat",
        "width": 1024,
        "height": 768,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "targets": ["app"],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": "Developer ID Application: Giuseppe Littera (LB4S6GSBK9)"
    },
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/128x128.png"],
    "resources": [
      "sidecar/siri-tts/siri-tts",
      "sidecar/macos-stt/macos-stt",
      "../../server/bot.py",
      "../../server/requirements.txt",
      "../../server/.env",
      "../../server/.venv/**/*",
      "../../server/config/**/*",
      "../../server/core/**/*",
      "../../server/components/**/*",
      "../../server/sidecars/**/*",
      "../../server/tools/**/*",
      "../../server/utils/**/*"
    ]
  }
}
